{
  "name": "@jiangkoumo/pi-pstack",
  "version": "0.2.0",
  "description": "Pi adaptation of pstack engineering skills, workflows, and bounded autonomous execution",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangkoumo/pi-pstack.git"
  },
  "homepage": "https://github.com/jiangkoumo/pi-pstack#readme",
  "bugs": {
    "url": "https://github.com/jiangkoumo/pi-pstack/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "adapters/",
    "upstream/",
    "docs/",
    "scripts/",
    "AGENTS.md",
    "LICENSE",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "jiti": "^2.7.0"
  },
  "pi": {
    "extensions": ["./extensions/pstack/index.ts"],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "node scripts/check-package.mjs && node --test scripts/p2-runtime.test.mjs && node --test scripts/loop.test.mjs && node --test scripts/generation.test.mjs && node --test scripts/writer-gate.test.mjs && node --test scripts/coverage.test.mjs && node --test scripts/check-plan.test.mjs && node --test scripts/runtime-next.test.mjs && node --test scripts/role-agents.test.mjs && node scripts/check-p3-agents.mjs --allow-skip && node scripts/check-p3-readonly-gate.mjs --allow-skip && node scripts/check-abort-state.mjs && node scripts/check-parallel-roles.mjs --allow-skip",
    "generate": "node scripts/generate-pi-resources.mjs",
    "check:generate": "node scripts/generate-pi-resources.mjs --check",
    "check:generate:tests": "node --test scripts/generation.test.mjs",
    "release": "node scripts/release.mjs",
    "check:pi": "node scripts/check-pi-discovery.mjs",
    "check:pi:commands": "node scripts/check-pi-commands.mjs",
    "check:correct": "node scripts/check-correct-acceptance.mjs",
    "check:correct:history": "node scripts/check-published-links.mjs",
    "check:p3:host": "node scripts/check-p3-host.mjs",
    "check:p3:background": "node scripts/check-p3-background.mjs",
    "check:p3:worktrees": "node scripts/check-p3-worktrees.mjs",
    "check:p3:writer-gate": "node --test scripts/writer-gate.test.mjs",
    "check:p3:writer-flow": "node scripts/check-p3-writer-flow.mjs && P3_FLOW_BLOCK=1 node scripts/check-p3-writer-flow.mjs",
    "check:p3:live": "node scripts/check-p3-live-review.mjs",
    "check:p4": "node scripts/check-p4-install.mjs",
    "check:ci": "node scripts/check-ci-local.mjs",
    "check:loop": "node scripts/check-loop-host.mjs",
    "check:sim": "node scripts/check-real-codebase-simulation.mjs",
    "check:p5:loop": "node --test scripts/loop.test.mjs && node scripts/check-loop-host.mjs",
    "check:p3": "npm run check:p2 && npm run check:p3:agents && npm run check:p3:gate && npm run check:p3:writer-gate && npm run check:p3:writer-flow && npm run check:p3:host && npm run check:p3:background && npm run check:p3:worktrees",
    "check:p3:agents": "node scripts/check-p3-agents.mjs",
    "check:p3:gate": "node scripts/check-p3-readonly-gate.mjs",
    "check:p2": "node --test scripts/p2-runtime.test.mjs",
    "check:p2:host": "node scripts/check-p2-host.mjs",
    "check:p2:cli": "node scripts/check-p2-cli.mjs"
  }
}
